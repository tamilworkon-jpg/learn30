---
// `<Remediation mock={N} />` in kind: mock MDX → hydrated Remediation island with the mock's question refs.
import { getCollection } from 'astro:content';
import Remediation from './Remediation';
import { course, examGuide } from '../../lib/data';
import { summaryByDomain } from '../../lib/review';
import '../../styles/review.css';

interface Props {
  mock: number;
}
const { mock } = Astro.props;
const questions = (await getCollection('questions', (q) => q.data.set === `mock-${mock}`)).map(({ data: { id, domain, lessonRef, type, answer } }) => ({
  id,
  domain,
  lessonRef,
  type,
  answer,
}));
const domainNames = Object.fromEntries(examGuide.domains.map((d) => [d.id, d.name]));
const dayTitles = Object.fromEntries(course.days.map((d) => [String(d.day), d.title]));
const domainDays = Object.fromEntries(summaryByDomain(course, examGuide, 29).map((g) => [g.id, g.days.map((d) => d.day)]));
---

<Remediation client:visible mock={mock} questions={questions} domainNames={domainNames} dayTitles={dayTitles} domainDays={domainDays} />
