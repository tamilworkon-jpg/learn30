---
interface Props {
  current: 'services' | 'metrics' | 'coverage';
}
import { courseOf } from '../../lib/course-locals';
import { courseHref } from '../../lib/routes';
const { current } = Astro.props;
const { meta, metrics } = courseOf(Astro);
const tabs = [
  { key: 'services', href: courseHref(meta.id, 'cheatsheet', 'services'), label: `${meta.provider} services` },
  // Only courses with metric cheat-sheet data have that page (src/courses/<id>/metrics.ts).
  ...(metrics?.length ? [{ key: 'metrics', href: courseHref(meta.id, 'cheatsheet', 'metrics'), label: 'Evaluation metrics' }] : []),
  { key: 'coverage', href: courseHref(meta.id, 'coverage'), label: 'Exam coverage' },
];
---

<nav class="lookup-tabs" aria-label="Cheat sheets">
  {
    tabs.map((t) => (
      <a href={t.href} aria-current={t.key === current ? 'page' : undefined}>
        {t.label}
      </a>
    ))
  }
</nav>
