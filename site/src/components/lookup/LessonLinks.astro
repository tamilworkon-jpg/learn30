---
import { lessonLink } from '../../lib/lookup';
import { courseOf } from '../../lib/course-locals';

interface Props {
  refs: string[];
}
const { course, meta } = courseOf(Astro);
const links = Astro.props.refs.map((r) => lessonLink(r, course, meta.id));
---

<p class="entry-links" data-pagefind-ignore>
  Learn it:
  {
    links.map((l, i) => [
      i > 0 ? ' · ' : '',
      <a href={l.href}>{`${l.label}: ${l.title}`}</a>,
    ])
  }
</p>
