---
// T182 — slide presentation of a lesson. Wraps the server-rendered <article> (which stays the full lesson for
// search, print and no-JS); src/lib/slide-deck.ts pages it on the client. Default view = slides; the
// "Slides / Full page" choice is remembered per browser under its own key (not in the progress store).
import '../../styles/slides.css';
---

<div class="slide-deck" data-slide-deck>
  <script is:inline src="/scripts/lesson-view.js"></script>
  <div class="deck-bar" data-pagefind-ignore hidden>
    <div class="deck-title slide-only"></div>
    <div class="view-toggle" role="group" aria-label="Lesson view">
      <button type="button" data-view="slides" aria-pressed="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
        Slides
      </button>
      <button type="button" data-view="full" aria-pressed="false">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6"></path></svg>
        Full page
      </button>
    </div>
    <div class="deck-status slide-only">
      <span class="deck-count">Slide 1 of 1</span>
      <progress class="deck-progress" max="1" value="1" aria-label="Slide 1 of 1"></progress>
    </div>
  </div>
  <slot />
  <!-- Round ‹ › arrows centred on the slide card's left and right edges (positioned over the stage by
       slide-deck.ts); the header shows "Slide n of N", so there is no separate button bar. -->
  <div class="deck-controls" data-pagefind-ignore hidden>
    <button class="deck-arrow deck-prev" type="button" aria-label="Previous slide" title="Previous slide (←)">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
    </button>
    <button class="deck-arrow deck-next" type="button" aria-label="Next slide" title="Next slide (→)">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
    </button>
  </div>
  <p class="deck-live sr-only" aria-live="polite"></p>
</div>

<script>
  import { initSlideDeck } from '../../lib/slide-deck';
  document.querySelectorAll<HTMLElement>('[data-slide-deck]').forEach(initSlideDeck);
</script>
