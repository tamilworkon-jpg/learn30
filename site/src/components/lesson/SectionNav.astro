---
// T039 — "Today's sections": sticky on desktop (via the layout aside), collapsible on mobile.
// Rendered open so it works without JS; the script collapses it on narrow screens.
import type { ParsedSection } from '../../lib/lesson-parse';

interface Props {
  sections: ParsedSection[];
}
const { sections } = Astro.props;
---

<nav class="section-nav" aria-label="Today's sections">
  <details class="section-nav-toggle" open>
    <summary class="h2">
      Today's sections <span class="muted text-sm font-normal">({sections.length})</span>
    </summary>
    <ol class="list-none p-0 m-0">
      {
        sections.map((s, i) => (
          <li>
            <a class="list-row" href={`#${s.id}`} data-nav-for={s.id}>
              <span class="num-icon">{i + 1}</span>
              <span class="flex-1 font-medium">{s.title}</span>
              <span class="muted text-sm">{s.optional ? 'opt.' : `${s.minutes}m`}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </details>
</nav>

<script>
  const toggle = document.querySelector<HTMLDetailsElement>('.section-nav-toggle');
  const narrow = window.matchMedia('(max-width: 1000px)');
  const sync = () => {
    if (toggle) toggle.open = !narrow.matches;
  };
  sync();
  narrow.addEventListener('change', sync);
  // Collapse again after choosing a section on mobile so the content is visible.
  toggle?.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (!narrow.matches && target.closest('summary')) e.preventDefault(); // always expanded on desktop
    if (narrow.matches && target.closest('a')) toggle.open = false;
  });

  // Current section = the last one whose top has scrolled past 35% of the viewport.
  // Recomputed from layout on every scroll/resize/load, so late-loading images can't leave a stale highlight.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-nav-for]')].map((a) => [a.dataset.navFor!, a]));
  const sectionEls = [...document.querySelectorAll<HTMLElement>('[data-section-type]')];
  let current = '';
  let queued = false;
  const update = () => {
    queued = false;
    const line = window.innerHeight * 0.35;
    let id = sectionEls[0]?.id ?? '';
    for (const s of sectionEls) if (s.getBoundingClientRect().top <= line) id = s.id;
    if (id === current) return;
    links.get(current)?.removeAttribute('aria-current');
    links.get(id)?.setAttribute('aria-current', 'true');
    current = id;
  };
  const schedule = () => {
    if (!queued) {
      queued = true;
      requestAnimationFrame(update);
    }
  };
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule);
  window.addEventListener('load', schedule);
  sectionEls.forEach((s) => s.addEventListener('toggle', schedule)); // deep dive open/close
  update();
</script>

<style>
  .section-nav summary {
    list-style: none;
    cursor: default;
    margin: 0 0 8px;
  }
  .section-nav summary::-webkit-details-marker {
    display: none;
  }
  .section-nav :global([aria-current='true']) {
    background: var(--card);
    border-radius: 12px;
  }
  .section-nav :global([aria-current='true'] .num-icon) {
    background: var(--brand-purple);
    color: #fff;
  }
  @media (max-width: 1000px) {
    .section-nav-toggle {
      background: var(--card);
      border-radius: 20px;
      padding: 12px 16px;
    }
    .section-nav summary {
      cursor: pointer;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .section-nav summary::after {
      content: '▾';
      margin-left: auto;
    }
    .section-nav-toggle[open] summary {
      margin-bottom: 8px;
    }
    .section-nav-toggle[open] summary::after {
      content: '▴';
    }
    .section-nav ol {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 0 12px;
    }
  }
</style>
