---
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<p class="muted mt-0">By the end of this hour you will be able to:</p>
<ul class="objectives">
  {items.map((o) => <li>{o}</li>)}
</ul>

<style>
  .objectives {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .objectives li {
    background: var(--card);
    border-radius: 14px;
    padding: 10px 14px 10px 40px;
    position: relative;
  }
  .objectives li::before {
    content: '🎯';
    position: absolute;
    left: 12px;
  }
</style>
