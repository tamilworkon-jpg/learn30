---
// T058 — daily quiz section: loads `set: day-NN` questions and hydrates the QuizRunner island.
import QuizRunner from './QuizRunner';
import { lessonsOf, questionsOf } from '../../lib/course-content';
import { courseOf } from '../../lib/course-locals';
import { nextStepsContext } from '../../lib/next-steps-context';
import type { Question } from '../../lib/types';
import '../../styles/quiz.css';

interface Props {
  day: number;
}
const { day } = Astro.props;
const ctx = courseOf(Astro);
const courseId = ctx.meta.id;
const set = `day-${String(day).padStart(2, '0')}`;
const questions = (await questionsOf(courseId)).filter((q) => q.data.set === set).map((q) => q.data as Question).sort((a, b) => a.id.localeCompare(b.id));
const lessons = (await lessonsOf(courseId)).map((l) => ({ day: l.data.day as number, body: l.body }));
const next = nextStepsContext(ctx.course, courseId, day, questions, lessons);
---

<div class="quiz-slot" data-quiz-set={set}>
  <p class="muted mt-0">
    {questions.length} exam-style questions. Answer every question, submit on the last one and read the explanations — aim for 80%+ before moving on. Your answers are saved as you go.
  </p>
  <QuizRunner client:visible assessmentId={set} title={`Day ${day} · Daily quiz`} questions={questions} next={next} courseId={courseId} />
</div>
