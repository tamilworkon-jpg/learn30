---
import { pad } from '../../lib/data';
interface Props {
  day: number;
}
const { day } = Astro.props;
---

<div class="card quiz-slot" data-quiz-set={`day-${pad(day)}`}>
  <p class="m-0 font-semibold">📝 Daily quiz — 20 exam-style questions</p>
  <p class="muted m-0 mt-1 text-sm">Answer, submit and read every explanation. Aim for 80%+ before moving on.</p>
</div>
