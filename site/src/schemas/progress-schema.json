{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aip-course/progress",
  "title": "Learner progress for ONE course (server: progress(user_id, course_id); signed-out localStorage 'aip-course:v2:<courseId>'; export file). Learn30 v2: ranges are per course, checked in code.",
  "type": "object",
  "required": [
    "schemaVersion",
    "examGuideVersion",
    "startedAt",
    "days",
    "attempts",
    "inProgress",
    "streak",
    "badges",
    "settings"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "examGuideVersion": {
      "type": "string"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lastPosition": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "day",
        "sectionId",
        "updatedAt"
      ],
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "sectionId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "days": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[1-9][0-9]?$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "sectionsViewed"
        ],
        "properties": {
          "status": {
            "enum": [
              "not-started",
              "in-progress",
              "completed"
            ]
          },
          "sectionsViewed": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "bestScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "latestScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "attempts": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "id",
          "assessmentId",
          "kind",
          "startedAt",
          "submittedAt",
          "answers",
          "score",
          "byDomain",
          "autoSubmitted"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "assessmentId": {
            "type": "string",
            "pattern": "^(day-\\d{2}|week-\\d{1,2}|mock-\\d{1,2})$"
          },
          "kind": {
            "enum": [
              "daily",
              "weekly",
              "mock"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "answers": {
            "type": "object"
          },
          "flagged": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "score": {
            "type": "object",
            "required": [
              "correct",
              "total",
              "percent"
            ],
            "properties": {
              "correct": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 1
              },
              "percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "scaled": {
                "type": "integer",
                "minimum": 100,
                "maximum": 1000
              }
            }
          },
          "byDomain": {
            "type": "object",
            "propertyNames": {
              "pattern": "^D\\d{1,2}$"
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "correct",
                "total"
              ],
              "properties": {
                "correct": {
                  "type": "integer"
                },
                "total": {
                  "type": "integer"
                }
              }
            }
          },
          "autoSubmitted": {
            "type": "boolean"
          }
        }
      }
    },
    "inProgress": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "answers",
          "startedAt"
        ],
        "properties": {
          "answers": {
            "type": "object"
          },
          "flagged": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          },
          "checked": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "index": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "streak": {
      "type": "object",
      "required": [
        "current",
        "longest"
      ],
      "properties": {
        "current": {
          "type": "integer",
          "minimum": 0
        },
        "longest": {
          "type": "integer",
          "minimum": 0
        },
        "lastStudyDate": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "badges": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,40}$"
      },
      "uniqueItems": true
    },
    "settings": {
      "type": "object",
      "properties": {
        "theme": {
          "enum": [
            "light",
            "dark"
          ]
        }
      }
    },
    "ratings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^week-\\d{1,2}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      }
    },
    "courseId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,60}$"
    }
  },
  "x-import-rules": [
    "Reject files > 1 MB",
    "Parse as JSON only (never eval); validate against this schema before replacing state",
    "Strings are rendered as text, never as HTML",
    "Show summary (days completed, attempts) and require confirmation before overwrite"
  ]
}
