{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aip-course/progress",
  "title": "Learner progress (localStorage key 'aip-course:v1' and export file)",
  "type": "object",
  "required": ["schemaVersion", "examGuideVersion", "startedAt", "days", "attempts", "inProgress", "streak", "badges", "settings"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "examGuideVersion": { "type": "string" },
    "startedAt": { "type": "string", "format": "date-time" },
    "lastPosition": {
      "type": ["object", "null"],
      "required": ["day", "sectionId", "updatedAt"],
      "properties": {
        "day": { "type": "integer", "minimum": 1, "maximum": 30 },
        "sectionId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "days": {
      "type": "object",
      "propertyNames": { "pattern": "^([1-9]|[12][0-9]|30)$" },
      "additionalProperties": {
        "type": "object",
        "required": ["status", "sectionsViewed"],
        "properties": {
          "status": { "enum": ["not-started", "in-progress", "completed"] },
          "sectionsViewed": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "completedAt": { "type": "string", "format": "date-time" },
          "bestScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "latestScore": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "attempts": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "assessmentId", "kind", "startedAt", "submittedAt", "answers", "score", "byDomain", "autoSubmitted"],
        "properties": {
          "id": { "type": "string" },
          "assessmentId": { "type": "string", "pattern": "^(day-\\d{2}|week-[1-4]|mock-[1-3])$" },
          "kind": { "enum": ["daily", "weekly", "mock"] },
          "startedAt": { "type": "string", "format": "date-time" },
          "submittedAt": { "type": "string", "format": "date-time" },
          "answers": { "type": "object" },
          "flagged": { "type": "array", "items": { "type": "string" } },
          "score": {
            "type": "object",
            "required": ["correct", "total", "percent"],
            "properties": {
              "correct": { "type": "integer", "minimum": 0 },
              "total": { "type": "integer", "minimum": 1 },
              "percent": { "type": "number", "minimum": 0, "maximum": 100 },
              "scaled": { "type": "integer", "minimum": 100, "maximum": 1000 }
            }
          },
          "byDomain": {
            "type": "object",
            "propertyNames": { "enum": ["D1", "D2", "D3", "D4", "D5"] },
            "additionalProperties": {
              "type": "object",
              "required": ["correct", "total"],
              "properties": { "correct": { "type": "integer" }, "total": { "type": "integer" } }
            }
          },
          "autoSubmitted": { "type": "boolean" }
        }
      }
    },
    "inProgress": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["answers", "startedAt"],
        "properties": {
          "answers": { "type": "object" },
          "flagged": { "type": "array", "items": { "type": "string" } },
          "startedAt": { "type": "string", "format": "date-time" },
          "deadline": { "type": "string", "format": "date-time" }
        }
      }
    },
    "streak": {
      "type": "object",
      "required": ["current", "longest"],
      "properties": {
        "current": { "type": "integer", "minimum": 0 },
        "longest": { "type": "integer", "minimum": 0 },
        "lastStudyDate": { "type": "string", "format": "date" }
      }
    },
    "badges": { "type": "array", "items": { "enum": ["week-1", "week-2", "week-3", "week-4", "mock-pass", "streak-7", "course-complete"] }, "uniqueItems": true },
    "settings": {
      "type": "object",
      "properties": { "theme": { "enum": ["light", "dark"] } }
    },
    "ratings": {
      "type": "object",
      "propertyNames": { "pattern": "^week-[1-4]$" },
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 5 }
    }
  },
  "x-import-rules": [
    "Reject files > 1 MB",
    "Parse as JSON only (never eval); validate against this schema before replacing state",
    "Strings are rendered as text, never as HTML",
    "Show summary (days completed, attempts) and require confirmation before overwrite"
  ]
}
