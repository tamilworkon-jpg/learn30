---
// T093 — mock day (kind: mock, days 29–30): authored MDX (launch → remediation → [finalRevision → examStrategy]).
// Without MDX the day still offers its mock launch cards. Contract: specs/001-aws-ai-practitioner-course/contracts/review-and-mock-days.md
import { studyWeekOf } from '../lib/schedule';
import BaseLayout from './BaseLayout.astro';
import PlannedDate from '../components/schedule/PlannedDate.astro';
import MockLaunch from '../components/mock/MockLaunch.astro';
import { courseOf } from '../lib/course-locals';
import { courseHref } from '../lib/routes';
import { getPrevNext } from '../lib/lesson-utils';
import { weekOfDay } from '../lib/review';
import type { CourseDay } from '../lib/types';
import '../styles/review.css';

interface Props {
  cd: CourseDay;
  hasContent: boolean;
  title?: string;
}
const { cd, hasContent, title = cd.title } = Astro.props;
const { course, examGuide, meta, rules } = courseOf(Astro);
const courseId = meta.id;
const week = weekOfDay(course, cd.day)!;
const { prev, next } = getPrevNext(cd.day, course);
---

<BaseLayout active="outline" title={`Day ${cd.day}: ${title}`} course={courseId}>
  <p class="muted text-sm m-0">Week {studyWeekOf(cd.day)} · Module {week.number}: {week.title} › Day {cd.day}</p>
  <h1 class="h1">{title}</h1>
  <PlannedDate day={cd.day} />
  <div class="flex flex-wrap items-center gap-2 mb-2">
    {examGuide.domains.map((d) => <span class={`chip chip-${d.id}`}>{d.id}</span>)}
    <span class="pill pill-accent">Mock day · {examGuide.format.totalQuestions} Q · {examGuide.format.minutes} min</span>
  </div>
  <div class="mockday" data-mock-day={cd.day}>
    {
      hasContent ? (
        <article class="mockday-body" data-pagefind-body data-pagefind-filter={`course:${courseId}`}>
          <slot />
        </article>
      ) : (
        <>
          <div class="card mt-4" data-coming-soon="mock-day">
            <p class="m-0 font-semibold">🚧 Remediation plan and exam-day guide coming soon</p>
            <p class="m-0 muted">You can already launch the mock {(rules.mockLaunches[cd.day] ?? []).length > 1 ? 'exams' : 'exam'} below.</p>
          </div>
          {(rules.mockLaunches[cd.day] ?? []).map((n: number) => (
            <MockLaunch n={n} optional={n === rules.mock.count && n > 1} />
          ))}
        </>
      )
    }
    <nav class="prevnext" aria-label="Day navigation">
      {prev ? <a class="btn btn-ghost" href={courseHref(courseId, 'day', prev)}>← Previous: Day {prev}</a> : <span />}
      {next && <a class="btn" href={courseHref(courseId, 'day', next)}>Next: Day {next} →</a>}
    </nav>
  </div>
</BaseLayout>

<style>
  .mockday :global(.lesson-section) {
    margin-top: 32px;
    scroll-margin-top: 16px;
  }
  .mockday :global(.sec-head) {
    display: flex;
    align-items: baseline;
    gap: 8px;
    border-bottom: 2px solid var(--border);
    padding-bottom: 6px;
  }
  .mockday-body :global(p),
  .mockday-body :global(li) {
    line-height: 1.75;
  }
  .mockday-body :global(ol:not([class])) {
    list-style: decimal;
    padding-left: 1.6em;
  }
  .mockday-body :global(ul:not([class])) {
    list-style: disc;
    padding-left: 1.4em;
  }
  .mockday-body :global(li::marker) {
    color: var(--muted);
    font-weight: 600;
  }
  .prevnext {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 40px;
    flex-wrap: wrap;
  }
</style>
