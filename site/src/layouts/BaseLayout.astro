---
import AccountMenu from '../components/account/AccountMenu';
import ImportOffer from '../components/account/ImportOffer';
import '../styles/theme.css';
import '../styles/account.css';
import { examGuide } from '../lib/data';
import { loginHref } from '../lib/auth';
import { courses } from '../lib/courses-data';
import { CATALOGUE_HREF, COURSE_ID, DASHBOARD_HREF } from '../lib/routes';

interface Props {
  title: string;
  active?: 'courses' | 'home' | 'outline' | 'search' | 'glossary' | 'cheatsheet' | 'settings' | 'none';
  description?: string;
  /** false on /login and /signup: no signed-out banner / import offer there. */
  accountUi?: boolean;
}
const { title, active = 'none', description = 'A 30-day, one-hour-a-day course for the AWS Certified AI Practitioner (AIF-C01) exam.', accountUi = true } = Astro.props;
const signInHref = loginHref(Astro.url.pathname.replace(/\/$/, '') || '/');

const icons: Record<string, string> = {
  courses: 'M4 5a2 2 0 012-2h5v18H6a2 2 0 01-2-2zM13 3h5a2 2 0 012 2v14a2 2 0 01-2 2h-5zM7 7h2M15 7h2M15 11h2',
  home: 'M3 11l9-8 9 8v9a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1z',
  outline: 'M4 6h16M4 12h16M4 18h10',
  search: 'M11 4a7 7 0 105.3 11.6L21 20M11 4a7 7 0 010 14',
  glossary: 'M5 4h11a3 3 0 013 3v13H8a3 3 0 01-3-3zM5 17a3 3 0 013-3h11',
  cheatsheet: 'M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6',
  settings: 'M12 15a3 3 0 100-6 3 3 0 000 6zM19.4 15a1.7 1.7 0 00.3 1.8l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.7 1.7 0 00-1.8-.3 1.7 1.7 0 00-1 1.5V21a2 2 0 11-4 0v-.1a1.7 1.7 0 00-1.1-1.5 1.7 1.7 0 00-1.8.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.7 1.7 0 00.3-1.8 1.7 1.7 0 00-1.5-1H3a2 2 0 110-4h.1a1.7 1.7 0 001.5-1.1 1.7 1.7 0 00-.3-1.8l-.1-.1a2 2 0 112.8-2.8l.1.1a1.7 1.7 0 001.8.3H9a1.7 1.7 0 001-1.5V3a2 2 0 114 0v.1a1.7 1.7 0 001 1.5 1.7 1.7 0 001.8-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.7 1.7 0 00-.3 1.8V9a1.7 1.7 0 001.5 1H21a2 2 0 110 4h-.1a1.7 1.7 0 00-1.5 1z',
};
// T205 — two levels: the course catalogue (outer layer), the current course's pages, then the account.
const courseNav = [
  { key: 'home', href: DASHBOARD_HREF, label: 'Dashboard' },
  { key: 'outline', href: '/outline', label: 'Outline' },
  { key: 'search', href: '/search', label: 'Search' },
  { key: 'glossary', href: '/glossary', label: 'Glossary' },
  { key: 'cheatsheet', href: '/cheatsheet/services', label: 'Cheat sheets' },
];
const topNav = { key: 'courses', href: CATALOGUE_HREF, label: 'Courses' };
const accountNav = { key: 'settings', href: '/settings', label: 'Settings' };
const currentCourse = courses.find((c) => c.id === COURSE_ID)!;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · AIP 30</title>
  </head>
  <body>
    <!-- Before paint, after the bootstrap JSON has been parsed: theme, collapsed bars, html[data-auth]. -->
    <script is:inline src="/scripts/ui-prefs.js"></script>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="app">
      <aside class="sidebar" aria-label="Primary">
        <div class="brand-row">
          <a class="brand" href={CATALOGUE_HREF}><span class="brand-mark" aria-hidden="true">AI</span> <span class="brand-text">AIP · 30</span></a>
          <button class="rail-toggle" type="button" id="rail-toggle" aria-controls="primary-nav" aria-expanded="true" aria-label="Collapse navigation" title="Collapse navigation">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
          </button>
        </div>
        <nav class="nav" id="primary-nav" aria-label="Main navigation">
          <a href={topNav.href} aria-current={active === topNav.key ? 'page' : undefined} title={topNav.label}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={icons[topNav.key]} />
            </svg>
            <span class="nav-label">{topNav.label}</span>
          </a>
          <div class="nav-group" role="group" aria-labelledby="nav-course-h">
            <p class="nav-group-h" id="nav-course-h" title={currentCourse.title}>{currentCourse.shortTitle}</p>
            {
              courseNav.map((n) => (
                <a href={n.href} aria-current={active === n.key ? 'page' : undefined} title={`${n.label} · ${currentCourse.shortTitle}`}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={icons[n.key]} />
                  </svg>
                  <span class="nav-label">{n.label}</span>
                </a>
              ))
            }
          </div>
          <span class="nav-sep" aria-hidden="true"></span>
          <a href={accountNav.href} aria-current={active === accountNav.key ? 'page' : undefined} title={accountNav.label}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={icons[accountNav.key]} />
            </svg>
            <span class="nav-label">{accountNav.label}</span>
          </a>
        </nav>
        <div class="support-card">
          <strong>{examGuide.examCode} · v{examGuide.version}</strong>
          <p class="m-0 mt-1">65 questions · 90 min · pass 700</p>
        </div>
      </aside>
      <main class="panel" id="main">
        <div class="topbar">
          <a class="search-pill" href="/search" data-testid="search-pill">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={icons.search} /></svg>
            <span class="hidden sm:inline">Search lessons, terms, services…</span><span class="sm:hidden">Search…</span>
          </a>
          <span class="flex-1"></span>
          <p class="save-status" data-save-status role="status"></p>
          <button class="icon-btn" type="button" id="theme-toggle" aria-label="Switch to dark theme" title="Toggle theme">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"></path></svg>
          </button>
          {accountUi && <AccountMenu client:load />}
        </div>
        {
          accountUi && (
            <p class="signed-out-banner" data-signed-out-banner>
              <span>You're not signed in — lessons and quizzes work, but nothing is saved.</span>
              <a href={signInHref}>Sign in to save your progress</a>
            </p>
          )
        }
        {accountUi && <ImportOffer client:idle />}
        <slot />
        <footer class="site-footer">
          Exam guide v{examGuide.version} · last verified {examGuide.lastVerified} · {examGuide.examCode}. Independent study aid — not affiliated with AWS.
        </footer>
      </main>
    </div>
    <script>
      import { getStore } from '../lib/progress/store';
      import { readLocalTheme, writeLocalTheme } from '../lib/ui-state';
      const btn = document.getElementById('theme-toggle')!;
      const store = getStore();
      const apply = (t: 'light' | 'dark') => {
        document.documentElement.dataset.theme = t;
        btn.setAttribute('aria-label', t === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
      };
      // Signed in: the account's progress.settings.theme; signed out: this browser's UI fallback.
      apply(store.signedIn ? (store.get().settings.theme ?? 'light') : readLocalTheme());
      btn.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        store.setTheme(next);
        if (!store.signedIn) writeLocalTheme(next);
        apply(next);
      });
    </script>
    <script>
      // T187 — collapse the primary navigation to an icon rail (desktop).
      import { bindCollapse } from '../lib/ui-prefs';
      const rail = document.getElementById('rail-toggle');
      if (rail instanceof HTMLButtonElement) bindCollapse({ button: rail, attr: 'sidebar', labels: { collapse: 'Collapse navigation', expand: 'Expand navigation' } });
    </script>
      <script>
      // Wide tables / code blocks scroll horizontally on small screens: make them keyboard-focusable (WCAG 2.1.1).
      const markScrollable = () =>
        document.querySelectorAll<HTMLElement>('article table, article pre').forEach((el) => {
          if (el.scrollWidth > el.clientWidth + 1) el.tabIndex = 0;
          else el.removeAttribute('tabindex');
        });
      markScrollable();
      window.addEventListener('resize', markScrollable);
    </script>
  </body>
</html>
