---
import { studyWeekOf } from '../lib/schedule';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import PlannedDate from '../components/schedule/PlannedDate.astro';
import Section from '../components/lesson/Section.astro';
import Diagram from '../components/lesson/Diagram.astro';
import Callout from '../components/lesson/Callout.astro';
import HandsOnLab from '../components/lesson/HandsOnLab.astro';
import Recap from '../components/lesson/Recap.astro';
import Orientation from '../components/lesson/Orientation.astro';
import Objectives from '../components/lesson/Objectives.astro';
import QuizSlot from '../components/quiz/QuizSlot.astro';
import SectionNav from '../components/lesson/SectionNav.astro';
import SlideDeck from '../components/lesson/SlideDeck.astro';
import MarkComplete from '../components/lesson/MarkComplete';
import { weeksFromCourse } from '../lib/badges';
import '../styles/dashboard.css';
import { course, examGuide, pad } from '../lib/data';
import { coreMinutes, getPrevNext } from '../lib/lesson-utils';
import { parseLesson } from '../lib/lesson-parse';

interface Props {
  entry: CollectionEntry<'lessons'>;
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const sections = parseLesson(entry.body ?? '').sections;
const core = coreMinutes(sections);
const deep = sections.find((s) => s.optional);
const { prev, next } = getPrevNext(d.day, course);
const week = course.weeks.find((w) => d.day >= w.days[0] && d.day <= w.days[1])!;
const domainName = (id: string) => examGuide.domains.find((x) => x.id === id)?.name ?? id;
---

<BaseLayout active="outline" title={`Day ${d.day}: ${d.title}`}>
  <p class="muted text-sm m-0 lesson-crumbs">Week {studyWeekOf(d.day)} · Module {week.number}: {week.title} › Day {d.day}</p>
  <h1 class="h1">{d.title}</h1>
  <PlannedDate day={d.day} />
  <div role="status" class="skip-notice card" id="skip-notice" hidden data-day={d.day}>
    <span>👋 You haven't finished <strong>Day {d.day - 1}</strong> yet. That's okay — you can study in any order.</span>
    <button class="btn btn-ghost" type="button" id="skip-dismiss" aria-label="Dismiss notice">Dismiss</button>
  </div>
  <div class="lesson">
    <SlideDeck>
    <article data-pagefind-body data-lesson-day={d.day}>
      <div class="flex flex-wrap items-center gap-2 mb-2">
        {d.domains.map((id) => <span class={`chip chip-${id}`}>{id} · {domainName(id)}</span>)}
        <span class="pill pill-accent">⏱ {core} min core</span>
        {deep && <span class="pill pill-soft">+{deep.minutes} min optional deep dive</span>}
      </div>
      {
        d.sources && (
          <p class="muted text-sm mt-1">
            Matches: {d.sources.map((s) => `${s.provider === 'udemy' ? 'Udemy' : s.provider === 'skillbuilder' ? 'Skill Builder' : 'AWS docs'} “${s.title}”`).join(' · ')}
          </p>
        )
      }
      <Content components={{ Section, Diagram, Callout, HandsOnLab, Recap, Orientation, Objectives, QuizSlot }} />
      <MarkComplete client:visible day={d.day} nextHref={next ? `/day/${pad(next)}` : undefined} weeks={weeksFromCourse(course)} totalDays={course.days.length} />
      <nav class="prevnext" aria-label="Day navigation">
        {prev ? <a class="btn btn-ghost" href={`/day/${pad(prev)}`}>← Previous: Day {prev}</a> : <span />}
        {next && <a class="btn" href={`/day/${pad(next)}`}>Next: Day {next} →</a>}
      </nav>
    </article>
    </SlideDeck>
    <aside class="lesson-aside">
      <button class="sections-toggle" type="button" id="sections-toggle" aria-controls="lesson-aside-body" aria-expanded="true" aria-label="Hide today's sections" title="Hide today's sections">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
        <span class="sections-toggle-text">Sections</span>
      </button>
      <div class="lesson-aside-body" id="lesson-aside-body">
        <SectionNav sections={sections} />
        <div class="card mt-4 pastel-a">
          <strong>Exam guide v{examGuide.version}</strong>
          <p class="m-0 text-sm">Task statements {d.taskStatements.join(', ')} · verified {d.lastVerified}</p>
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  import { getStore } from '../lib/progress/store';
  import { trackSections } from '../lib/progress/section-tracker';
  import { bindCollapse } from '../lib/ui-prefs';

  // T187 — collapse "Today's sections" to a thin strip (desktop); the lesson takes the full width.
  const secToggle = document.getElementById('sections-toggle');
  if (secToggle instanceof HTMLButtonElement) bindCollapse({ button: secToggle, attr: 'sections', labels: { collapse: "Hide today's sections", expand: "Show today's sections" } });

  // T068 — record sections viewed + resume position.
  const lessonEl = document.querySelector<HTMLElement>('[data-lesson-day]');
  if (lessonEl) trackSections({ day: Number(lessonEl.dataset.lessonDay), sections: [...lessonEl.querySelectorAll('[data-section-type]')], store: getStore() });

  const notice = document.getElementById('skip-notice');
  if (notice) {
    const day = Number(notice.dataset.day);
    let prevDone = day === 1;
    try {
      prevDone ||= getStore().get().days[String(day - 1)]?.status === 'completed';
    } catch {
      /* treat as not completed */
    }
    if (!prevDone && sessionStorage.getItem(`skip-dismissed-${day}`) !== '1') notice.hidden = false;
    document.getElementById('skip-dismiss')?.addEventListener('click', () => {
      notice.hidden = true;
      sessionStorage.setItem(`skip-dismissed-${day}`, '1');
    });
  }
</script>

<style>
  .lesson {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 32px;
    margin-top: 8px;
  }
  .lesson-aside {
    position: sticky;
    top: 16px;
    align-self: start;
    max-height: calc(100vh - 32px);
    overflow: auto;
  }
  article :global(.lesson-section) {
    margin-top: 32px;
    scroll-margin-top: 16px;
  }
  article :global(.sec-head) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    border-bottom: 2px solid var(--border);
    padding-bottom: 6px;
  }
  /* Same reading scale as the glossary / cheat sheets: 14px text, 15px sub-headings. */
  article {
    font-size: 14px;
    line-height: 1.6;
  }
  article :global(p),
  article :global(li) {
    line-height: 1.6;
  }
  article :global(h3) {
    font-size: 15px;
  }
  article :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    display: block;
    overflow-x: auto;
  }
  article :global(th),
  article :global(td) {
    border: 1px solid var(--border);
    padding: 8px 10px;
    text-align: left;
    vertical-align: top;
  }
  article :global(th) {
    background: var(--card);
  }
  article :global(code) {
    background: var(--card);
    padding: 1px 6px;
    border-radius: 6px;
    font-size: 0.9em;
  }
  article :global(pre) {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 12px 14px;
    overflow-x: auto;
    line-height: 1.6;
  }
  article :global(pre code) {
    background: none;
    padding: 0;
    white-space: pre;
  }
  article :global(.deep-dive) {
    background: var(--deep-bg);
    color: var(--deep-text);
    border-radius: 20px;
    padding: 14px 18px;
  }
  article :global(.deep-dive summary) {
    cursor: pointer;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  .pill-soft {
    background: var(--card);
    color: var(--text);
  }
  .pastel-a {
    background: #efeafd;
    color: #1f1a3a;
  }
  :global([data-theme='dark']) .pastel-a {
    background: var(--card);
    color: var(--text);
  }
  .skip-notice:not([hidden]) {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    background: var(--real-bg);
    color: var(--real-text);
    margin: 8px 0;
  }
  .prevnext {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 40px;
    flex-wrap: wrap;
  }
  .sections-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 10px auto;
    padding: 6px 12px;
    min-height: 36px;
    border-radius: 999px;
    background: var(--card);
    color: var(--text);
    border: 1px solid var(--border);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .sections-toggle:focus-visible {
    outline: 3px solid var(--brand-orange);
    outline-offset: 2px;
  }
  .lesson-aside {
    display: flex;
    flex-direction: column;
  }
  @media (min-width: 1001px) {
    /* Expanded: the toggle sits on the "Today's sections" heading row instead of taking its own row. */
    :global(html:not([data-sections='collapsed'])) .sections-toggle {
      position: absolute;
      top: 0;
      right: 0;
      z-index: 1;
      margin: 0;
      padding: 6px 10px;
    }
    /* icon-only while expanded (the name comes from aria-label) */
    :global(html:not([data-sections='collapsed'])) .sections-toggle-text {
      display: none;
    }
    :global([data-sections='collapsed']) .lesson {
      grid-template-columns: minmax(0, 1fr) 44px;
      gap: 16px;
    }
    :global([data-sections='collapsed']) .lesson-aside-body {
      display: none;
    }
    :global([data-sections='collapsed']) .sections-toggle {
      writing-mode: vertical-rl;
      margin: 0;
      padding: 14px 8px;
      gap: 8px;
    }
    :global([data-sections='collapsed']) .sections-toggle svg {
      transform: rotate(180deg);
    }
  }
  @media (max-width: 1000px) {
    .sections-toggle {
      display: none;
    }
    .lesson {
      grid-template-columns: minmax(0, 1fr);
    }
    .lesson-aside {
      position: static;
      order: -1;
      max-height: none;
    }
  }
</style>
