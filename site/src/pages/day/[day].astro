---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LessonLayout from '../../layouts/LessonLayout.astro';
import ReviewLayout from '../../layouts/ReviewLayout.astro';
import Section from '../../components/lesson/Section.astro';
import Diagram from '../../components/lesson/Diagram.astro';
import Callout from '../../components/lesson/Callout.astro';
import { course, pad } from '../../lib/data';
import { weeklySetId } from '../../lib/review';
import type { Question } from '../../lib/types';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return course.days.map((cd) => ({
    params: { day: pad(cd.day) },
    props: { cd, entry: lessons.find((l) => l.data.day === cd.day) },
  }));
}
const { cd, entry } = Astro.props;
const Content = entry && cd.kind !== 'lesson' ? (await render(entry)).Content : null;
const weeklySet = weeklySetId(course, cd.day);
const weekly: Question[] = weeklySet
  ? (await getCollection('questions', (q) => q.data.set === weeklySet)).map((q) => q.data as Question).sort((a, b) => a.id.localeCompare(b.id))
  : [];
---

{
  cd.kind === 'review' ? (
    <ReviewLayout cd={cd} questions={weekly} hasContent={Boolean(Content)} title={entry?.data.title}>
      {Content && <Content components={{ Section, Diagram, Callout }} />}
    </ReviewLayout>
  ) : entry ? (
    <LessonLayout entry={entry} />
  ) : (
    <BaseLayout title={`Day ${cd.day}: ${cd.title}`}>
      <p class="muted text-sm m-0">Day {cd.day}</p>
      <h1 class="h1">{cd.title}</h1>
      <div class="card mt-4">
        <p class="m-0 font-semibold">🚧 Coming soon</p>
        <p class="m-0 muted">This day is being written. Continue with the latest available day from the dashboard.</p>
      </div>
      {cd.day > 1 && (
        <p class="mt-4">
          <a href={`/day/${pad(cd.day - 1)}`}>← Day {cd.day - 1}</a>
        </p>
      )}
    </BaseLayout>
  )
}
