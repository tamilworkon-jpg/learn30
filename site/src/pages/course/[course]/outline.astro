---
import '../../../styles/profiles.css';
// T076 — course outline: weeks → days → sections, rendered at build time; a small script adds the
// learner's status icons from the progress store.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { buildPlan } from '../../../lib/course-plan';
import { availableCourseIds, getCourse } from '../../../lib/course-data';
import { lessonsOf } from '../../../lib/course-content';
import { courseHref } from '../../../lib/routes';
import { STUDY_WEEKS, studyWeekDays } from '../../../lib/schedule';
import '../../../styles/dashboard.css';

export function getStaticPaths() {
  return availableCourseIds().map((course) => ({ params: { course } }));
}
const courseId = Astro.params.course!;
Astro.locals.courseId = courseId;
const { course, examGuide } = getCourse(courseId);
const lessons = await lessonsOf(courseId);
const plan = buildPlan(
  course,
  examGuide.domains,
  lessons.map((l) => ({ day: l.data.day, body: l.body })),
  courseId,
);
const domainName = (id: string) => examGuide.domains.find((d) => d.id === id)?.name ?? id;
// Study weeks of five lesson days (Mon–Fri); each lists the modules (topic groups) it covers.
const studyWeeks = Array.from({ length: STUDY_WEEKS }, (_, i) => {
  const days = studyWeekDays(i + 1);
  const modules = plan.weeks.filter((w) => w.days.some((n) => days.includes(n)));
  return { number: i + 1, days, modules };
});
const kindLabel = { lesson: '', review: 'Review & test', mock: 'Mock exam' } as const;
---

<BaseLayout title="Course outline" active="outline" course={courseId}>
  <div data-outline>
    <h1 class="h1">Course outline</h1>
    <p class="muted mt-0">
      {plan.days.length} days · {STUDY_WEEKS} weeks of five days (Monday–Friday, weekends free) · {plan.weeks.length} modules · about an hour a day. Jump to any day — the order is a suggestion.
    </p>
    <p class="outline-legend text-sm" aria-hidden="true">
      <span><span class="status-icon" data-s="completed">✓</span> Completed</span>
      <span><span class="status-icon" data-s="in-progress">◐</span> In progress</span>
      <span><span class="status-icon" data-s="not-started">○</span> Not started</span>
    </p>
    {
      studyWeeks.map((w) => (
        <section class="outline-week" data-week={w.number} aria-labelledby={`week-${w.number}-h`}>
          <h2 class="h2" id={`week-${w.number}-h`}>
            Week {w.number} · Days {w.days[0]}–{w.days[w.days.length - 1]}
            <span class="muted text-sm font-normal" data-week-dates={`${w.days[0]}-${w.days[w.days.length - 1]}`}></span>
          </h2>
          <p class="muted text-sm mt-0 outline-modules">{w.modules.map((m) => `Module ${m.number} · ${m.title}`).join('  ·  ')}</p>
          <ol class="outline-days" role="list">
            {w.days.map((n) => {
              const d = plan.days.find((x) => x.day === n)!;
              return (
                <li class="outline-day card" data-day-row={n} data-status="not-started">
                  <div class="outline-day-head">
                    <span class="status-icon" data-s="not-started" role="img" aria-label="Not started">
                      ○
                    </span>
                    <span class="num-icon">{n}</span>
                    <a class="outline-day-title" href={courseHref(courseId, 'day', n)}>
                      {d.title}
                    </a>
                    <span class="outline-date muted text-sm" data-plan-date></span>
                    <span class="outline-day-meta">
                      {d.domains.map((id) => (
                        <span class={`chip chip-${id}`} title={domainName(id)}>
                          {id}
                        </span>
                      ))}
                      {kindLabel[d.kind] && <span class="pill pill-soft">{kindLabel[d.kind]}</span>}
                      {d.available ? <span class="pill pill-accent">⏱ {d.minutes} min</span> : <span class="pill pill-soon">🚧 Coming soon</span>}
                    </span>
                  </div>
                  {d.sections.length > 0 && (
                    <details class="outline-secs">
                      <summary class="text-sm">
                        {d.sections.length} sections<span class="sr-only"> in Day {n}</span>
                      </summary>
                      <ol role="list">
                        {d.sections.map((s) => (
                          <li data-section={s.id} data-viewed="false">
                            <span class="sec-icon" role="img" aria-label="Not viewed">
                              ○
                            </span>
                            <a href={courseHref(courseId, 'day', n, s.id)}>{s.title}</a>
                            <span class="muted text-sm">{s.optional ? 'optional' : `${s.minutes} min`}</span>
                          </li>
                        ))}
                      </ol>
                    </details>
                  )}
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }
  </div>
</BaseLayout>

<script>
  import { getStore } from '../../../lib/progress/store';
  import { formatDate, isStudyDay, planDayOn, plannedDate } from '../../../lib/schedule';

  const ICON = { completed: ['✓', 'Completed'], 'in-progress': ['◐', 'In progress'], 'not-started': ['○', 'Not started'] } as const;
  const root = document.querySelector<HTMLElement>('[data-outline]')!;
  const render = () => {
    const p = getStore().get();
    const start = new Date(p.startedAt);
    const now = new Date();
    const todayPlan = planDayOn(start, now);
    const todayLabel = isStudyDay(now) ? 'Today · ' : 'Next · '; // weekends: highlight Monday's day
    root.querySelectorAll<HTMLElement>('[data-day-row]').forEach((row) => {
      // T183 — the learner's planned date for this day (browser calendar).
      const n = Number(row.dataset.dayRow);
      const dateEl = row.querySelector<HTMLElement>('[data-plan-date]');
      if (dateEl) dateEl.textContent = (n === todayPlan ? todayLabel : '') + formatDate(plannedDate(start, n));
      row.toggleAttribute('data-today', n === todayPlan);
      const ds = p.days[row.dataset.dayRow!];
      const status = ds?.status ?? 'not-started';
      row.dataset.status = status;
      const icon = row.querySelector<HTMLElement>('.status-icon')!;
      icon.textContent = ICON[status][0];
      icon.dataset.s = status;
      icon.setAttribute('aria-label', ICON[status][1]);
      const viewed = new Set(ds?.sectionsViewed ?? []);
      row.querySelectorAll<HTMLElement>('[data-section]').forEach((li) => {
        const v = status === 'completed' || viewed.has(li.dataset.section!);
        li.dataset.viewed = String(v);
        const si = li.querySelector<HTMLElement>('.sec-icon')!;
        si.textContent = v ? '✓' : '○';
        si.setAttribute('aria-label', v ? 'Viewed' : 'Not viewed');
      });
      if (status === 'in-progress') row.querySelector('details')?.setAttribute('open', '');
    });
    // Each study week's planned Monday–Friday range for this learner.
    root.querySelectorAll<HTMLElement>('[data-week-dates]').forEach((el) => {
      const [a, b] = el.dataset.weekDates!.split('-').map(Number);
      el.textContent = ` · ${formatDate(plannedDate(start, a)).replace(/,? \d{4}$/, '')} – ${formatDate(plannedDate(start, b))}`;
    });
    root.dataset.ready = 'true';
  };
  render();
  getStore().subscribe(render);
</script>
