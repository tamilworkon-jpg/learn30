---
// Learn30 L020 — /course/<id>/day/NN: lesson, review or mock day of a course.
import { render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import LessonLayout from '../../../../layouts/LessonLayout.astro';
import ReviewLayout from '../../../../layouts/ReviewLayout.astro';
import MockDayLayout from '../../../../layouts/MockDayLayout.astro';
import Section from '../../../../components/lesson/Section.astro';
import Diagram from '../../../../components/lesson/Diagram.astro';
import Callout from '../../../../components/lesson/Callout.astro';
import MockLaunch from '../../../../components/mock/MockLaunch.astro';
import RemediationSlot from '../../../../components/mock/RemediationSlot.astro';
import { availableCourseIds, getCourse } from '../../../../lib/course-data';
import { lessonsOf, questionsOf } from '../../../../lib/course-content';
import { courseHref } from '../../../../lib/routes';
import { weeklySetId } from '../../../../lib/review';
import type { Question } from '../../../../lib/types';

export async function getStaticPaths() {
  const paths = [];
  for (const courseId of availableCourseIds()) {
    const { course } = getCourse(courseId);
    const lessons = await lessonsOf(courseId);
    for (const cd of course.days) {
      paths.push({ params: { course: courseId, day: String(cd.day).padStart(2, '0') }, props: { cd, entry: lessons.find((l) => l.data.day === cd.day) } });
    }
  }
  return paths;
}
const courseId = Astro.params.course!;
Astro.locals.courseId = courseId;
const { course } = getCourse(courseId);
const { cd, entry } = Astro.props;
const Content = entry && cd.kind !== 'lesson' ? (await render(entry)).Content : null;
const weeklySet = weeklySetId(course, cd.day);
const weekly: Question[] = weeklySet
  ? (await questionsOf(courseId))
      .filter((q) => q.data.set === weeklySet)
      .map((q) => q.data as Question)
      .sort((a, b) => a.id.localeCompare(b.id))
  : [];
---

{
  cd.kind === 'review' ? (
    <ReviewLayout cd={cd} questions={weekly} hasContent={Boolean(Content)} title={entry?.data.title}>
      {Content && <Content components={{ Section, Diagram, Callout }} />}
    </ReviewLayout>
  ) : cd.kind === 'mock' ? (
    <MockDayLayout cd={cd} hasContent={Boolean(Content)} title={entry?.data.title}>
      {Content && <Content components={{ Section, Diagram, Callout, MockLaunch, Remediation: RemediationSlot }} />}
    </MockDayLayout>
  ) : entry ? (
    <LessonLayout entry={entry} />
  ) : (
    <BaseLayout active="outline" title={`Day ${cd.day}: ${cd.title}`} course={courseId}>
      <p class="muted text-sm m-0">Day {cd.day}</p>
      <h1 class="h1">{cd.title}</h1>
      <div class="card mt-4">
        <p class="m-0 font-semibold">🚧 Coming soon</p>
        <p class="m-0 muted">This day is being written. Continue with the latest available day from the dashboard.</p>
      </div>
      {cd.day > 1 && (
        <p class="mt-4">
          <a href={courseHref(courseId, 'day', cd.day - 1)}>← Day {cd.day - 1}</a>
        </p>
      )}
    </BaseLayout>
  )
}
