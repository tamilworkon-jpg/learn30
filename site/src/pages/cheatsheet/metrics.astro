---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LessonLinks from '../../components/lookup/LessonLinks.astro';
import LookupTabs from '../../components/lookup/LookupTabs.astro';
import { metricGroups } from '../../data/metrics';
import { slugify } from '../../schemas/lookup';
import '../../styles/lookup.css';
---

<BaseLayout title="Evaluation metrics cheat sheet" active="cheatsheet" description="ML and GenAI evaluation metrics on the AIF-C01 exam: accuracy, precision, recall, F1, AUC, RMSE, ROUGE, BLEU, BERTScore and business metrics.">
  <LookupTabs current="metrics" />
  <div data-pagefind-body>
    <h1 class="h1">Evaluation metrics cheat sheet</h1>
    <p class="muted lookup-intro">Which number to look at, and the exam wording that points to it. Classic ML metrics (TS 1.3), GenAI evaluation (TS 3.4) and business value (TS 2.2).</p>

    <nav aria-label="Metric groups" class="facet-group my-4" data-pagefind-ignore>
      {
        metricGroups.map((g) => (
          <a class="facet no-underline" href={`#${g.id}`}>
            {g.title.replace(/ \(.*\)$/, '')}
          </a>
        ))
      }
    </nav>

    <section class="card" aria-labelledby="confusion-matrix">
      <h2 class="h2 mt-0" id="confusion-matrix">Confusion matrix</h2>
      <div class="flex flex-wrap gap-6 items-start">
        <table class="cm-table" data-testid="confusion-matrix">
          <caption class="sr-only">Confusion matrix: actual class in rows, predicted class in columns</caption>
          <thead>
            <tr><td></td><th scope="col">Predicted positive</th><th scope="col">Predicted negative</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">Actually positive</th><td class="cm-good"><strong>TP</strong><br />true positive</td><td class="cm-bad"><strong>FN</strong><br />missed (type II)</td></tr>
            <tr><th scope="row">Actually negative</th><td class="cm-bad"><strong>FP</strong><br />false alarm (type I)</td><td class="cm-good"><strong>TN</strong><br />true negative</td></tr>
          </tbody>
        </table>
        <ul class="text-sm m-0 pl-5 list-disc flex-1 min-w-[220px]">
          <li><strong>Precision</strong> reads down the <em>predicted positive</em> column: TP ÷ (TP + FP).</li>
          <li><strong>Recall</strong> reads across the <em>actually positive</em> row: TP ÷ (TP + FN).</li>
          <li><strong>Accuracy</strong> is the diagonal (TP + TN) over everything.</li>
          <li>Too many false alarms → improve precision. Too many misses → improve recall.</li>
        </ul>
      </div>
    </section>

    {
      metricGroups.map((g) => (
        <section aria-labelledby={g.id}>
          <h2 class="h2 mt-8 mb-1" id={g.id}>
            {g.title}
          </h2>
          <p class="muted text-sm mt-0">{g.intro}</p>
          <div class="entry-grid">
            {g.metrics.map((m) => (
              <article class="entry" data-testid="metric">
                <h3 id={`metric-${slugify(m.name)}`}>{m.name}</h3>
                <div class="meta">
                  {m.ts.map((ts) => (
                    <span class="ts-pill">TS {ts}</span>
                  ))}
                </div>
                {m.formula && <code class="metric-formula">{m.formula}</code>}
                <p>{m.what}</p>
                <p class="choose-when">
                  <strong class="block">Use when</strong>
                  {m.useWhen}
                </p>
                {m.trap && (
                  <p class="cue">
                    <strong class="block">Exam cue</strong>
                    {m.trap}
                  </p>
                )}
                <LessonLinks refs={m.lessonRefs} />
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
