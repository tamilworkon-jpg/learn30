---
import { getCollection } from 'astro:content';
import MockExam from '../../components/mock/MockExam.astro';
import type { Question } from '../../lib/types';

export function getStaticPaths() {
  return [1, 2, 3].map((n) => ({ params: { n: String(n) }, props: { n } }));
}
const { n } = Astro.props;
const questions = (await getCollection('questions', (q) => q.data.set === `mock-${n}`))
  .map((q) => q.data as Question)
  .sort((a, b) => a.id.localeCompare(b.id));
---

<MockExam n={n} questions={questions} />
