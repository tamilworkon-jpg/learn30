---
// T077 — settings: export / import / reset progress; T183/T184 learners + start date.
import BaseLayout from '../layouts/BaseLayout.astro';
import ProgressIO from '../components/settings/ProgressIO';
import LearnerSettings from '../components/settings/LearnerSettings';
import '../styles/dashboard.css';
---

<BaseLayout title="Settings" active="settings">
  <h1 class="h1">Settings</h1>
  <p class="muted mt-0 max-w-3xl">
    Progress is saved per learner, only in this browser, separately for each address you open the site on (for example <code>localhost</code> and a forwarded port URL). Use export
    and import to move it between them or to keep a backup.
  </p>
  <ProgressIO client:load />
  <LearnerSettings client:load />
</BaseLayout>
