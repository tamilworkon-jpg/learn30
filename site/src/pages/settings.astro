---
// T077 — settings: export / import / reset progress.
import BaseLayout from '../layouts/BaseLayout.astro';
import ProgressIO from '../components/settings/ProgressIO';
import '../styles/dashboard.css';
---

<BaseLayout title="Settings" active="settings">
  <h1 class="h1">Settings</h1>
  <p class="muted mt-0 max-w-3xl">
    Your progress is saved only in this browser, separately for each address you open the site on (for example <code>localhost</code> and a forwarded port URL). Use export
    and import to move it between them or to keep a backup.
  </p>
  <ProgressIO client:load />
</BaseLayout>
