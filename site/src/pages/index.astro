---
// T205 — home = the course catalogue (the outer layer; each course has its own dashboard). Public page; signed-in learners see their progress on each course.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseCards from '../components/courses/CourseCards';
import { buildPlan } from '../lib/course-plan';
import { courses } from '../lib/courses-data';
import { course, examGuide } from '../lib/data';
import '../styles/dashboard.css';

const lessons = await getCollection('lessons');
const plan = buildPlan(
  course,
  examGuide.domains,
  lessons.map((l) => ({ day: l.data.day, body: l.body })),
);
---

<BaseLayout title="Courses" active="courses">
  <h1 class="h1">Courses</h1>
  <p class="muted mt-0">Pick a course and study about an hour a day. Your progress is saved to your account.</p>
  <CourseCards client:load courses={courses} plan={plan} />
</BaseLayout>
