---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/lookup.css';

// Pagefind compiles its index reader to WebAssembly; allow wasm compilation on this page only (no eval for JS).
Astro.csp.insertScriptResource("'wasm-unsafe-eval'");
---

<BaseLayout title="Search" active="search" description="Search lessons, glossary terms and AWS service cards.">
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <h1 class="h1">Search</h1>
  <p class="muted lookup-intro">
    Search every lesson, the <a href="/glossary">glossary</a> and the <a href="/cheatsheet/services">services</a> and <a href="/cheatsheet/metrics">metrics</a> cheat sheets. Works offline — the index ships with the site.
  </p>
  <div id="search" class="search-host" data-testid="search"></div>
  <p class="card mt-4" id="search-unavailable" hidden>
    The search index has not been built. Run <code>npm run build</code> (which runs Pagefind) and open the preview server to search.
  </p>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
</BaseLayout>

<script>
  type PagefindUIType = new (opts: Record<string, unknown>) => { triggerSearch(term: string): void };
  const PagefindUI = (window as unknown as { PagefindUI?: PagefindUIType }).PagefindUI;
  if (!PagefindUI) {
    document.getElementById('search-unavailable')!.hidden = false;
  } else {
    const ui = new PagefindUI({
      element: '#search',
      showSubResults: true,
      showImages: false,
      pageSize: 10,
      autofocus: true,
      resetStyles: false,
      translations: { placeholder: 'Search the course' },
    });
    // Pagefind's input only has a placeholder; give it a real accessible name.
    const label = () => document.querySelector('#search input')?.setAttribute('aria-label', 'Search the course');
    label();
    new MutationObserver(label).observe(document.getElementById('search')!, { childList: true, subtree: true });
    const q = new URLSearchParams(location.search).get('q');
    if (q) ui.triggerSearch(q);
  }
</script>
