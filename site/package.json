{
  "name": "aip-course",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "predev": "npm run prepare:assets",
    "prebuild": "npm run prepare:assets",
    "prepare:assets": "tsx scripts/build-validators.ts && tsx scripts/render-diagrams.ts",
    "build": "astro build && pagefind --site dist",
    "build:e2e": "npm run prepare:assets && astro build --outDir dist-e2e && pagefind --site dist-e2e",
    "preview": "astro preview",
    "start": "npm run build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "validate:content": "tsx scripts/validate-content.ts",
    "audit:tasks": "tsx scripts/audit-tasks.ts",
    "verify": "npm run lint && npm run typecheck && npm run validate:content && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/preact": "^4.1.3",
    "@fontsource/poppins": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "^5.18.2",
    "js-yaml": "^5.5.0",
    "mermaid": "^12.2.0",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "jsdom": "^29.1.1",
    "mermaid-isomorphic": "^3.1.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
