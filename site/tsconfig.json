{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*", "tests/**/*", "*.config.*"],
  "exclude": ["dist", "node_modules", "tests/fixtures/lint", "src/schemas/generated/*.js"]
}
