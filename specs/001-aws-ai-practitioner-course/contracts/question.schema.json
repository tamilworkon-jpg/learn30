{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aip-course/question",
  "title": "Exam-style question",
  "type": "object",
  "required": ["id", "set", "type", "stem", "options", "answer", "explanation", "domain", "taskStatement", "lessonRef", "difficulty"],
  "properties": {
    "id": { "type": "string", "pattern": "^q-(day-\\d{2}|week-[1-4]|mock-[1-3])-\\d{3}$" },
    "set": { "type": "string", "pattern": "^(day-\\d{2}|week-[1-4]|mock-[1-3])$" },
    "type": { "enum": ["single", "multi", "ordering", "matching"] },
    "stem": { "type": "string", "minLength": 10 },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "explanation"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "explanation": { "type": "string", "minLength": 5 }
        }
      }
    },
    "matchTargets": {
      "type": "array",
      "description": "Right-hand items for matching questions",
      "items": { "type": "object", "required": ["id", "text"], "properties": { "id": { "type": "string" }, "text": { "type": "string" } } }
    },
    "answer": {
      "oneOf": [
        { "type": "array", "items": { "type": "string" }, "description": "single/multi: correct option ids; ordering: option ids in correct order" },
        { "type": "object", "additionalProperties": { "type": "string" }, "description": "matching: optionId -> matchTargetId" }
      ]
    },
    "explanation": { "type": "string", "minLength": 20 },
    "domain": { "enum": ["D1", "D2", "D3", "D4", "D5"] },
    "taskStatement": { "type": "string", "pattern": "^[1-5]\\.[1-4]$" },
    "lessonRef": { "type": "string", "pattern": "^day-\\d{2}#[a-z0-9-]+$" },
    "difficulty": { "enum": ["easy", "medium", "hard"] }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "single" } } }, "then": { "properties": { "options": { "minItems": 4, "maxItems": 4 }, "answer": { "type": "array", "minItems": 1, "maxItems": 1 } } } },
    { "if": { "properties": { "type": { "const": "multi" } } }, "then": { "properties": { "options": { "minItems": 5 }, "answer": { "type": "array", "minItems": 2 } } } },
    { "if": { "properties": { "type": { "const": "ordering" } } }, "then": { "properties": { "options": { "minItems": 3, "maxItems": 5 } } } },
    { "if": { "properties": { "type": { "const": "matching" } } }, "then": { "required": ["matchTargets"], "properties": { "options": { "minItems": 3, "maxItems": 7 }, "answer": { "type": "object" } } } }
  ],
  "x-set-rules": {
    "day-NN": { "count": [15, 20] },
    "week-N": { "count": [55, 60] },
    "mock-N": { "count": 65, "domainSplit": { "D1": 13, "D2": 16, "D3": 18, "D4": 9, "D5": 9 } },
    "global": ["ids unique across all sets", "no stem reused across sets", "every task statement has >= 3 questions"]
  }
}
